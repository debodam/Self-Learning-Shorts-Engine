# Copy to .env.local and fill in. Never commit .env.local.
# Any integration left blank falls back to mock data, so the app always runs.
# These keys are temporary and will move to Aced's accounts later.

# Supabase (Postgres + pgvector)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=

# OpusClip API (https://api.opus.pro)
OPUSCLIP_API_KEY=
# Optional. Only needed if the API key's user belongs to more than one Opus organization.
OPUSCLIP_ORG_ID=
# Brand template for weekly submissions. Optional: defaults to the template named "Aced ...".
OPUSCLIP_BRAND_TEMPLATE_ID=
# Scheduling posts only to the YouTube account with this name in Opus's connected social
# accounts. Defaults to "Exponent". Anything named like Ace Your Interviews is always refused.
OPUSCLIP_YOUTUBE_ACCOUNT_NAME=
# Optional cross-check: the Opus postAccountId that the lookup above must return.
OPUSCLIP_YOUTUBE_POST_ACCOUNT_ID=
# Set to true to force mock Opus responses (no credits spent, mock data saved) for testing.
OPUSCLIP_MOCK=
# Optional path to an ffmpeg binary for frame extraction. Defaults to the bundled ffmpeg-static.
FFMPEG_PATH=

# YouTube Data + Analytics APIs (OAuth client with offline access)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
