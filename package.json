{
  "name": "aced-shorts-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "import:v1": "node --env-file-if-exists=.env.local scripts/import-v1-performance.mts",
    "job:weekly-candidates": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/jobs/weekly-candidates.ts",
    "job:metrics-pull": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/jobs/metrics-pull.ts",
    "job:embed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/jobs/embed.ts",
    "job:label-shorts": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/jobs/label-shorts.ts",
    "job:weekly-report": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/jobs/weekly-report.ts",
    "job:backtest": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/jobs/backtest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "csv-parse": "^7.0.3",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
